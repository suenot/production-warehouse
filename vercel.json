{
 "rewrites": [
  {
   "source": "/mcp",
   "destination": "/api/mcp"
  },
  {
   "source": "/items.json",
   "destination": "https://media.production-warehouse.suenot.com/items.json"
  }
 ],
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    }
   ]
  }
 ]
}
