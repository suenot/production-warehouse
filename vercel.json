{
 "rewrites": [
  {
   "source": "/mcp",
   "destination": "/api/mcp"
  },
  {
   "source": "/catalog.json",
   "destination": "/api/catalog"
  },
  {
   "source": "/items.json",
   "destination": "https://media.production-warehouse.suenot.com/items.json"
  }
 ],
 "headers": [
  {
   "source": "/assets/(.*)",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=31536000, immutable"
    }
   ]
  },
  {
   "source": "/items.json",
   "headers": [
    {
     "key": "Cache-Control",
     "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
    }
   ]
  },
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    }
   ]
  }
 ]
}
